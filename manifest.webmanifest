{
  "name": "Tally — Your everyday food tracker",
  "short_name": "Tally",
  "description": "A friendly food tracker for your everyday meals, movement, and go-to foods. Your data stays on your phone.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0e1116",
  "theme_color": "#0e1116",
  "shortcuts": [
    {
      "name": "Log food",
      "short_name": "Food",
      "url": "./index.html?action=food",
      "icons": [{ "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Log exercise",
      "short_name": "Exercise",
      "url": "./index.html?action=exercise",
      "icons": [{ "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ],
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ]
}
